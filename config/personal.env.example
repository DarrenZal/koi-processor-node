# KOI Processor - Personal Deployment Configuration (Example)
# Copy to personal.env and fill in real values.
#
# Usage: set -a; source config/personal.env; set +a
#        venv/bin/python -m uvicorn api.personal_ingest_api:app --host 127.0.0.1 --port 8351
# Access control, service tokens and which routes check them:
# docs/operations/quickstart-personal-koi.md, step 7.

# ============================================
# DEPLOYMENT MODE
# ============================================
KOI_MODE=personal
DEPLOYMENT_PROFILE=personal

# ============================================
# DATABASE CONFIGURATION
# ============================================
POSTGRES_URL=postgresql://youruser:@localhost:5432/personal_koi

# ============================================
# EMBEDDING CONFIGURATION
# ============================================
OPENAI_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=3072

# ============================================
# DEEP-EXTRACTION TRANSPORT (optional)
# ============================================
# Which model runs entity/fact/discourse extraction (extract_deep_documents.py).
# Default transport is 'claude_p' (Claude Code subscription, $0) — leave it unset
# for that. Set these ONLY to opt into a different transport for a run/batch job.
#
# DOC_EXTRACTOR_TRANSPORT=claude_p        # claude_p (default) | api | openai
# DOC_EXTRACTOR_MODEL=claude-sonnet-4-6   # model for claude_p/api
# CLAUDE_BIN=                             # claude_p: the claude CLI (default: claude on PATH)
# ANTHROPIC_API_KEY=                      # api: required; claude_p never passes it to the CLI
#
# 'openai' = any OpenAI-compatible /v1/chat/completions endpoint — BRING YOUR OWN
# model (public OpenAI, self-hosted vLLM/Ollama, a provider-hosted open model).
# Defaults target public OpenAI, so with just an OPENAI_API_KEY it works out of box;
# override BASE_URL/MODEL to point at your own infra.
# DOC_EXTRACTOR_OPENAI_BASE_URL=https://api.openai.com/v1
# DOC_EXTRACTOR_OPENAI_MODEL=gpt-4o-mini
# DOC_EXTRACTOR_OPENAI_API_KEY=            # falls back to OPENAI_API_KEY if unset
# DOC_EXTRACTOR_OPENAI_NO_THINK=0          # =1 for reasoning models on vLLM (Qwen3 etc.)
# DOC_EXTRACTOR_REPAIR_PASSES=2            # re-ask smaller models on invalid JSON

# ============================================
# CLAIMS LEDGER ANCHORING (optional)
# ============================================
# POST /claims/{rid}/anchor runs the regen CLI and signs with a key in its "test"
# keyring. The defaults point at MAINNET (chain regen-1, a public RPC and REST
# endpoint, key name claims-service). Set these before you anchor anything:
# REGEN_CLI_PATH=                          # the regen binary (default: regen on PATH)
# REGEN_CHAIN_ID=regen-1
# REGEN_RPC_URL=
# REGEN_REST_URL=
# REGEN_KEY_NAME=claims-service

# ============================================
# PERSONAL KOI API
# ============================================
KOI_API_PORT=8351
WEB_SENSOR_ENABLED=false
QUERY_ENDPOINT_ENABLED=true
VAULT_SYNC_ENABLED=false

# /health reports embedding_available from the embedding repair job's state file.
# Set this to the file scripts/backfill_null_embeddings.py writes (its --state-file;
# default logs/embedding-repair-state.json in this repository) and run that job every 300s.
# EMBED_REPAIR_STATE_FILE=/path/to/koi-processor/logs/embedding-repair-state.json

# ============================================
# ACCESS CONTROL AND SERVICE TOKENS (optional)
# ============================================
# Most routes, writes included, have no authentication: keep the API on 127.0.0.1.
# Each token is any long random string, sent as "Authorization: Bearer <token>".
#
# log (default): the read routes (/search, /query, unified and discourse search) accept
# anonymous callers. enforce: they return 401 without a known token.
# KOI_AUTH_MODE=enforce
#
# Each gives the personal (full) read scope. KOI_ADMIN_TOKEN also guards the
# localhost-only KOI-net admin routes (or put it in $KOI_STATE_DIR/admin_token).
# KOI_ADMIN_TOKEN=
# KOI_MCP_TOKEN=
#
# Needed for deep extraction and the standard/thorough ingest tiers: set the same value
# for the API and for the scripts (POST /knowledge/episodes, /claims writes, /entities/merge).
# KOI_CLAIMS_SERVICE_TOKEN=
# Where the scripts send those writes.
# DOC_INGEST_KOI_URL=http://localhost:8351
#
# Only POST /documents/ingest and GET /documents/{rid}; source files must be under the root.
# KOI_INGEST_SERVICE_TOKEN=
# INGEST_SOURCE_ROOT=/path/to/sources
#
# Session-token emails that get the personal read scope (comma-separated).
# KOI_PERSONAL_PRINCIPALS=you@example.com
# Narrower read scopes: JSON {"<sha256 of token>": {"view": "public"}} (api/read_scope.py).
# KOI_READ_SCOPES_FILE=/path/to/read-scopes.json
#
# POST /sql runs as the read-only role scripts/sql_ro_role.py --apply creates.
# KOI_SQL_RO_DSN=postgresql://koi_sql_ro@localhost:5432/personal_koi

# ============================================
# RESOLVER POLICY SHADOW (temporary measurement)
# ============================================
# Behavior-neutral comparison of the explicitly named legacy and strict
# resolver policies. Evaluation reuses already-fetched candidates; emission is
# asynchronous through a bounded queue. The runtime kill switch is the first
# flag below. Target gate: >=1,000 attempts over >=7 days, every production
# caller observed or fixture-covered, and p95 shadow overhead <=5%.
KOI_RESOLVER_SHADOW_ENABLED=false
KOI_RESOLVER_SHADOW_SAMPLE_RATE=0.10
KOI_RESOLVER_SHADOW_QUEUE_SIZE=1024

# ============================================
# OBSIDIAN VAULT CONFIGURATION
# ============================================
OBSIDIAN_VAULT_PATH=/path/to/your/vault

# ============================================
# PROCESSING CONFIGURATION
# ============================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ============================================
# KOI-NET FEDERATION
# ============================================
KOI_NET_ENABLED=false
# This node's name in its KOI-net node RID. Set your own; the code's default is the
# maintainer's node name.
KOI_NODE_NAME=my-personal-node
# Node keys, the admin_token file and the auth observation log live here.
KOI_STATE_DIR=/path/to/koi-state
KOI_BASE_URL=http://127.0.0.1:8351
KOI_STRICT_MODE=false
KOI_NET_REQUIRE_APPROVED_EDGE_FOR_POLL=true
KOI_ENFORCE_SOURCE_KEY_RID_BINDING=true

# --- Domain federation gates (both default OFF; leave unset to keep them off) ---
# `regen-prod` deploys to more than one node, so a new receive-side domain ships
# disabled everywhere and is enabled per node by setting the flag there.
#
# knowledge_episode / knowledge_fact / document_entity_link domains:
# KOI_FEDERATE_KNOWLEDGE=false
#
# document domain — lands federated documents as locally-searchable RAG content
# (chunked + embedded at 3072-dim into koi_memories / koi_memory_chunks):
# KOI_FEDERATE_DOCUMENTS=false
#
# Containment for the document domain: comma-separated substrings a document RID
# must contain to be allowed to land. UNSET uses the built-in default
# ("newsletter_nate-jones-substack_"). Set-but-EMPTY allows nothing — there is
# deliberately no way to express "allow everything", because server-side
# `rid_types` edge scoping does not work for these RIDs and this is the only
# containment there is.
# KOI_FEDERATE_DOCUMENTS_RID_ALLOW=newsletter_nate-jones-substack_
#
# Subscriber addresses to strip from federated document bodies before they are
# chunked and indexed, in plaintext AND inside base64 tracking tokens.
# Comma-separated; NEVER hardcoded in the repo (this branch pushes to a shared
# remote). Unset = no redaction, with a warning logged once per process.
# This MODIFIES STORED CONTENT — the verbatim original stays in the fetched
# bundle snapshot and the manifest hash is computed over the untouched bundle.
# KOI_FEDERATE_DOCUMENTS_REDACT_EMAILS=you@example.com,alias@example.com

# ============================================
# TERMINUSDB (Graph Storage Layer - Optional)
# ============================================
# Set TERMINUSDB_ENABLED=true to enable graph sync.
# TerminusDB runs alongside PostgreSQL as eventual-consistency store.
# It needs api/terminusdb_adapter.py and scripts/terminusdb/, which the public export
# does not include; without them the node logs a warning and skips the mirror.
TERMINUSDB_ENABLED=false
TERMINUSDB_URL=http://127.0.0.1:6363/
TERMINUSDB_DB=koi_knowledge_graph
TERMINUSDB_TEAM=admin
TERMINUSDB_KEY=changeme

# ============================================
# MEDIAWIKI SENSOR (Optional — live-sync external MediaWikis)
# ============================================
# Set to true to start the background sensor that polls registered wikis
# in mediawiki_wikis (sync_mode='poll', status='active').
MEDIAWIKI_SENSOR_ENABLED=false
MEDIAWIKI_POLL_INTERVAL=600

# ============================================
# NOT READ BY THE PERSONAL NODE
# ============================================
# Earlier versions of this template set these. No code the personal node runs reads
# them, so they are left here commented out.
# USE_ISOLATED_TABLES=true
# KOI_COORDINATOR_URL=http://localhost:8005
# EVENT_BRIDGE_PORT=8100
# OBSIDIAN_VAULT_NAME=personal
# FUSEKI_URL=http://localhost:3030
# FUSEKI_DATASET=personal-koi
# MIN_CONTENT_LENGTH=50
# CHUNK_PROCESSING_DELAY=0.05
# LOG_LEVEL=INFO
# CODE_GRAPH_ENABLED=false
# KG_EXTRACTION_ENABLED=true
